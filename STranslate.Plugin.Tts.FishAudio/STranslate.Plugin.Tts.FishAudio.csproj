<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RepositoryUrl>https://github.com/Cirnouo/STranslate.Plugin.Tts.FishAudio</RepositoryUrl>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>..\.artifacts\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>..\.artifacts\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
        <EnableAutoPackage>true</EnableAutoPackage>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Languages\*.*">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\Licenses\Octicons.LICENSE.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Resource Include="s2-pro-free-promo.webp" />
        <Content Include="plugin.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="STranslate.Plugin" Version="1.0.15" />
        <PackageReference Include="NAudio.Core" Version="2.3.0" />
        <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
        <PackageReference Include="MessagePack" Version="3.1.12" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="STranslate.Plugin.Tts.FishAudio.Tests" />
    </ItemGroup>

    <!-- A plugin library does not copy every NuGet runtime asset by default. Keep
         host SDK/UI dependencies shared, and copy only private audio/WS runtimes.
         Use resolved runtime assets so NuGet chooses the compatible framework. -->
    <Target Name="IncludePreviewRuntimeDependencies"
            AfterTargets="ResolveLockFileCopyLocalFiles"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <ItemGroup>
            <_FishAudioPreviewCoreRuntime Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'NAudio.Core' and '%(RuntimeCopyLocalItems.Filename)' == 'NAudio.Core' and '%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
            <_FishAudioPreviewWinMMRuntime Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'NAudio.WinMM' and '%(RuntimeCopyLocalItems.Filename)' == 'NAudio.WinMM' and '%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
            <_FishAudioMessagePackRuntime Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'MessagePack' and '%(RuntimeCopyLocalItems.Filename)' == 'MessagePack' and '%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
            <_FishAudioMessagePackAnnotationsRuntime Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'MessagePack.Annotations' and '%(RuntimeCopyLocalItems.Filename)' == 'MessagePack.Annotations' and '%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
            <_FishAudioStringToolsRuntime Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.NET.StringTools' and '%(RuntimeCopyLocalItems.Filename)' == 'Microsoft.NET.StringTools' and '%(RuntimeCopyLocalItems.Extension)' == '.dll'" />
        </ItemGroup>
        <Error Condition="'@(_FishAudioPreviewCoreRuntime->Count())' != '1' or '@(_FishAudioPreviewWinMMRuntime->Count())' != '1'"
               Text="Preview runtime resolution must provide exactly NAudio.Core.dll and NAudio.WinMM.dll before packaging." />
        <Error Condition="'@(_FishAudioMessagePackRuntime->Count())' != '1' or '@(_FishAudioMessagePackAnnotationsRuntime->Count())' != '1' or '@(_FishAudioStringToolsRuntime->Count())' != '1'"
               Text="Streaming runtime resolution must provide MessagePack.dll, MessagePack.Annotations.dll and Microsoft.NET.StringTools.dll before packaging." />
        <ItemGroup>
            <ReferenceCopyLocalPaths Include="@(_FishAudioPreviewCoreRuntime);@(_FishAudioPreviewWinMMRuntime);@(_FishAudioMessagePackRuntime);@(_FishAudioMessagePackAnnotationsRuntime);@(_FishAudioStringToolsRuntime)"
                                     Exclude="@(ReferenceCopyLocalPaths)"
                                     KeepDuplicates="false" />
        </ItemGroup>
    </Target>

</Project>
