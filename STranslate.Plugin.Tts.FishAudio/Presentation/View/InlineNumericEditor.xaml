<UserControl x:Class="STranslate.Plugin.Tts.FishAudio.View.InlineNumericEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="82" Height="32" Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>
        <Button x:Name="DisplayButton" Width="58" Height="32" MinWidth="0" MinHeight="0"
                Padding="0" BorderThickness="0" Background="Transparent" BorderBrush="Transparent"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}" Click="DisplayButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBox x:Name="EditorBox" Width="58" Height="32" MinWidth="0" MinHeight="0"
                 Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center"
                 Visibility="Collapsed" LostKeyboardFocus="EditorBox_LostKeyboardFocus" KeyDown="EditorBox_KeyDown" />
        <TextBlock x:Name="UnitText" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </Grid>
</UserControl>
