<UserControl x:Class="STranslate.Plugin.Tts.FishAudio.View.SearchAdjustmentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:STranslate.Plugin.Tts.FishAudio.View"
    Focusable="False" Width="28" Height="28">
    <UserControl.Resources>
        <DataTemplate x:Key="LanguageOptionTemplate">
            <StackPanel Orientation="Horizontal">
                <view:LanguageFlagImage Source="{Binding Flag}" Width="18" Height="13.5" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,8,0">
                    <view:LanguageFlagImage.Style>
                        <Style TargetType="view:LanguageFlagImage">
                            <Style.Triggers><DataTrigger Binding="{Binding Flag}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </view:LanguageFlagImage.Style>
                </view:LanguageFlagImage>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="AdjustmentButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="5" BorderThickness="0" Background="Transparent"
                Click="Adjustment_Click" ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}"
                AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}">
            <Grid Width="16" Height="16">
                <Path Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M1,4 L4,4 M9,4 L15,4 M1,12 L7,12 M12,12 L15,12"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,1.5,0,0"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,9.5,0,0"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSearchAdjustments}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
            </Grid>
        </Button>
        <Popup x:Name="AdjustmentPopup" PlacementTarget="{Binding ElementName=AdjustmentButton}" Placement="Custom" StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="PopupSurface" Width="324" Padding="16" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource FlyoutPresenterBackground}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Popup_PreviewKeyDown">
                <ScrollViewer x:Name="PopupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" Height="28" MinHeight="0" MinWidth="0" Padding="7" Margin="8,-4,-4,0"
                                    BorderThickness="0" Background="Transparent" Click="Close_Click"
                                    ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Close}" AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Close}">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Button>
                            <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Language}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" MaxDropDownHeight="270"
                                  ItemTemplate="{StaticResource LanguageOptionTemplate}" SelectedValuePath="Code"
                                  AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Language}"/>
                        <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Sort}" Margin="0,16,0,6"/>
                        <RadioButton x:Name="RelevanceRadio" GroupName="SearchSort" IsChecked="True" Margin="0,0,0,6"
                                     Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Relevance}"
                                     AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Relevance}"/>
                        <RadioButton x:Name="PopularityRadio" GroupName="SearchSort" Margin="0,0,0,6"
                                     Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Popularity}"
                                     AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Popularity}"/>
                        <RadioButton x:Name="CreationRadio" GroupName="SearchSort"
                                     Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_CreationTime}"
                                     AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_CreationTime}"/>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="ResetButton" HorizontalAlignment="Left" Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Reset}" Click="Reset_Click"/>
                            <Button x:Name="ApplyButton" Grid.Column="1" Margin="12,0,0,0" Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Apply}" Click="Apply_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
