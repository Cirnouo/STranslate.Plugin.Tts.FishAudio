<UserControl x:Class="STranslate.Plugin.Tts.FishAudio.View.SearchAdjustmentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:view="clr-namespace:STranslate.Plugin.Tts.FishAudio.View"
    Focusable="False" Width="28" Height="28">
    <UserControl.Resources>
        <DataTemplate x:Key="LanguageOptionTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <view:LanguageFlagImage Source="{Binding Flag}" Width="18" Height="13.5" Stretch="Fill" VerticalAlignment="Center" Margin="0,0,6,0">
                    <view:LanguageFlagImage.Style>
                        <Style TargetType="view:LanguageFlagImage">
                            <Style.Triggers><DataTrigger Binding="{Binding Flag}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </view:LanguageFlagImage.Style>
                </view:LanguageFlagImage>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Path Grid.Column="2" Data="M0,4 L3,7 L9,0" Width="10" Height="9" Stretch="Uniform" StrokeThickness="1.5" Margin="6,0,0,0" VerticalAlignment="Center"
                      Stroke="{DynamicResource AccentFillColorDefaultBrush}">
                    <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></Path.Style>
                </Path>
            </Grid>
        </DataTemplate>
        <Style x:Key="LanguageTileStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource LanguageOptionTemplate}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="TileBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="AdjustmentButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="5" BorderThickness="0" Background="Transparent"
                Click="Adjustment_Click" ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}"
                AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}">
            <Grid Width="16" Height="16">
                <Path Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M1,4 L4,4 M9,4 L15,4 M1,12 L7,12 M12,12 L15,12"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,1.5,0,0"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,9.5,0,0"/>
                <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSearchAdjustments}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
            </Grid>
        </Button>
        <Popup x:Name="AdjustmentPopup" PlacementTarget="{Binding ElementName=AdjustmentButton}" Placement="Custom" StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="PopupSurface" view:ActionCursor.IsScope="True" Width="324" Padding="12" CornerRadius="{DynamicResource OverlayCornerRadius}" BorderThickness="{DynamicResource FlyoutBorderThemeThickness}"
                    BorderBrush="{DynamicResource FlyoutBorderThemeBrush}" Background="{DynamicResource FlyoutPresenterBackground}"
                    TextElement.FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="Popup_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel x:Name="PopupHeader" MinHeight="28" Margin="0,0,0,12">
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" Height="28" MinHeight="0" MinWidth="0" Padding="7" Margin="8,0,0,0"
                                BorderThickness="0" Background="Transparent" Click="Close_Click"
                                ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Close}" AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Close}">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Button>
                        <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Adjustments}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ScrollViewer x:Name="PopupScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Language}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <Grid x:Name="LanguageTiles">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/><RowDefinition Height="6"/><RowDefinition Height="32"/><RowDefinition Height="6"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="6"/><RowDefinition Height="32"/><RowDefinition Height="6"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="6"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                            </Grid>
                            <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Sort}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,4"/>
                            <RadioButton x:Name="RelevanceRadio" GroupName="SearchSort" IsChecked="True" MinHeight="32"
                                         Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Relevance}"
                                         AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Relevance}"/>
                            <RadioButton x:Name="PopularityRadio" GroupName="SearchSort" MinHeight="32"
                                         Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Popularity}"
                                         AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Popularity}"/>
                            <RadioButton x:Name="CreationRadio" GroupName="SearchSort" MinHeight="32"
                                         Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_CreationTime}"
                                         AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_CreationTime}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="PopupFooter" Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource FlyoutBorderThemeBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ResetButton" MinHeight="32" HorizontalAlignment="Left" Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search_Reset}" Click="Reset_Click"/>
                        <Button x:Name="ApplyButton" MinHeight="32" Style="{DynamicResource AccentButtonStyle}" Grid.Column="1" Margin="12,0,0,0" Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Apply}" Click="Apply_Click"/>
                    </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
