<UserControl
    x:Class="STranslate.Plugin.Tts.FishAudio.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:iNKORE.UI.WPF.Modern.Controls.Helpers;assembly=iNKORE.UI.WPF.Modern"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin"
    xmlns:conv="clr-namespace:STranslate.Plugin.Tts.FishAudio.Converter"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Tts.FishAudio.ViewModel"
    xmlns:view="clr-namespace:STranslate.Plugin.Tts.FishAudio.View"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="1400"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:TaskCountConverter x:Key="TaskCountConverter" />
        <conv:ProgressToDashOffsetConverter x:Key="ProgressToDashOffsetConverter" />
        <BooleanToVisibilityConverter x:Key="BtvConverter" />
        <Style x:Key="VoiceTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_CopyVoiceId}" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_CopyVoiceId}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BareIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BareIconSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <view:InkCenteredGlyph Glyph="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BareIconSurface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BareIconSurface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BareIconSurface" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter TargetName="BareIconSurface" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <!-- WPF displays FocusVisualStyle for keyboard navigation only.
                 IsKeyboardFocused also remains true after a mouse click. -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultToggleChevronStyle" TargetType="Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
            <Setter Property="Data" Value="M 1,1 L 5,5 L 9,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Data" Value="M 1,5 L 5,1 L 9,5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewPreparingSpinner" TargetType="Grid">
            <Setter Property="Visibility" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BtvConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="PreviewPreparingStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PreviewPreparingStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="VoiceCardTemplate">
            <Border Margin="0,2" Padding="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" UseLayoutRounding="False">
                        <Button Width="32" Height="32" Margin="0,0,4,0" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Add}" />
                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Add}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Remove}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Remove}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="18" Height="18" Stretch="Fill" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Data="M 12,2 L 14.94,8.04 L 21.61,9.02 L 16.8,13.72 L 17.93,20.36 L 12,17.22 L 6.07,20.36 L 7.2,13.72 L 2.39,9.02 L 9.06,8.04 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Fill" Value="#FFFFC857" />
                                                <Setter Property="Stroke" Value="#FFFFC857" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Grid Width="36" Height="36" Margin="0,0,4,0"
                              Visibility="{Binding SampleAudioUrl, Converter={StaticResource StringToVisibilityConverter}}">
                            <Ellipse x:Name="SRestBorder" StrokeThickness="1"
                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Fill="Transparent" />
                            <Ellipse x:Name="STrack" StrokeThickness="1.5"
                                     Stroke="#1FFFFFFF" Fill="Transparent" Visibility="Collapsed" />
                            <Ellipse x:Name="SArc" StrokeThickness="1.5" Stroke="White" Fill="Transparent"
                                     StrokeDashArray="72.26 72.26"
                                     StrokeDashOffset="{Binding PreviewProgress, Converter={StaticResource ProgressToDashOffsetConverter}}"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid Style="{StaticResource PreviewPreparingSpinner}" Tag="{Binding IsPreparingPreview}"
                                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                                <Ellipse Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                                         StrokeDashArray="18 54" StrokeDashCap="Round" />
                            </Grid>
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Width="36" Height="36"
                                    Command="{Binding DataContext.ToggleSearchItemPreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_PlaySample}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_PlaySample}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBeingPreviewed}" Value="True">
                                                <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_Stop}" />
                                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_Stop}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPreparingPreview}" Value="True">
                                                <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_CancelLoading}" />
                                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_CancelLoading}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <view:InkCenteredGlyph x:Name="SIcon" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE768;" />
                                    <Border x:Name="SStopIcon" Width="9" Height="9" CornerRadius="1" Background="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                        <Button IsEnabled="{Binding CanToggleSelection}"
                                Command="{Binding DataContext.SelectVoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BareIconButtonStyle}">
                                    <Setter Property="Content" Value="&#xE73E;" />
                                    <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Apply}" />
                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Apply}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                            <Setter Property="Content" Value="&#xE711;" />
                                            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearVoice}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearVoice}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Ellipse DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource VoiceTitleButtonStyle}"
                                Command="{Binding DataContext.CopyVoiceIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Id}">
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                   TextTrimming="WordEllipsis" TextWrapping="Wrap" MaxHeight="30" />
                        <view:VoiceLanguageTags Languages="{Binding Languages}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding IsLoadingMetadata, Converter={StaticResource BtvConverter}}">
                            <Grid Width="12" Height="12" Margin="0,0,4,0" IsHitTestVisible="False"
                                  Style="{StaticResource PreviewPreparingSpinner}" Tag="{Binding IsLoadingMetadata}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                                <Ellipse Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"
                                         StrokeDashArray="5 15" StrokeDashCap="Round" />
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Voice_LoadingMetadata}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MetadataError}" FontSize="11" MaxWidth="280" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding MetadataError, Converter={StaticResource StringToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AuthorName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11">
                                <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Popularity}" />
                                <Run Text="{Binding TaskCount, Converter={StaticResource TaskCountConverter}, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBeingPreviewed}" Value="True">
                    <Setter TargetName="STrack" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SArc" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreviewActive}" Value="True">
                    <Setter TargetName="SRestBorder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SStopIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ikw:SimpleStackPanel Spacing="12">

        <Border
            Visibility="{Binding ShowS21ProFreePromo, Converter={StaticResource BtvConverter}}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            Cursor="Hand"
            MouseLeftButtonUp="S21ProFreePromoCard_MouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <Image
                        Width="1024"
                        Height="540"
                        Source="/STranslate.Plugin.Tts.FishAudio;component/s2-pro-free-promo.webp"
                        Stretch="Fill" />
                </Viewbox>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="6"
                    Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Command="{Binding DismissS21ProFreePromoCommand}"
                    ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Promo_Close}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <!-- ════════ 账户 ════════ -->

        <TextBlock
            Margin="0,4,0,0"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Account}" />

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_AccountInfo}">
            <ui:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Credit_NotLoaded}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserCredit}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Credit}" VerticalAlignment="Center"
                               Visibility="{Binding UserCredit, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock Margin="4,0,0,0" Text="{Binding UserCredit}" VerticalAlignment="Center"
                               Visibility="{Binding UserCredit, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock Text=" $" VerticalAlignment="Center"
                               Visibility="{Binding UserCredit, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Person_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    Command="{Binding RefreshCreditCommand}"
                    Content="{DynamicResource STranslate_Plugin_Tts_FishAudio_Refresh}" />
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding LatencyText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Grid x:Name="LatencyBars" Width="14" Height="12" Margin="0,0,4,0"
                          VerticalAlignment="Center">
                        <Rectangle Width="3" Height="5" RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Fill="{Binding LatencyBrush}" />
                        <Rectangle Width="3" Height="8" RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Fill="{Binding LatencyBrush}" />
                        <Rectangle Width="3" Height="11" RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Fill="{Binding LatencyBrush}" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="12"
                               Foreground="{Binding LatencyBrush}" Text="{Binding LatencyText}" />
                </StackPanel>
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Url}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="https://api.fish.audio" />
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_ApiKey}">
            <ui:SettingsCard.Description>
                <ui:HyperlinkButton
                    Content="fish.audio"
                    NavigateUri="https://fish.audio/app/api-keys" />
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Key_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Grid>
                <PasswordBox helpers:TextBoxHelper.IsDeleteButtonVisible="False" helpers:PasswordBoxHelper.PasswordRevealMode="Hidden"
                    IsEnabled="{Binding IsApiKeyInputEnabled}"
                    MinWidth="230" Padding="10,4,40,4"
                    plugin:PasswordBoxAssistant.Attach="True"
                    plugin:PasswordBoxAssistant.Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ui:ControlHelper.PlaceholderText="{DynamicResource STranslate_Plugin_Tts_FishAudio_ApiKey_Placeholder}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Margin="0,0,4,0" Padding="6"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding PasteApiKeyCommand}"
                        ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Paste}"
                        AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Paste}">
                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </Grid>
        </ui:SettingsCard>

        <!-- ════════ 声音 ════════ -->

        <TextBlock
            Margin="0,8,0,0"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Voice}" />

        <!-- 展示区：已选声音 -->
        <Border
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" UseLayoutRounding="False">
                    <Button Width="32" Height="32" Margin="0,0,4,0" Padding="6"
                            Background="Transparent" BorderThickness="0"
                            Command="{Binding ToggleSelectedVoiceFavoriteCommand}"
                            Visibility="{Binding CachedVoiceId, Converter={StaticResource StringToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Add}" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Add}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedVoiceFavorite}" Value="True">
                                        <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Remove}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorite_Remove}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="18" Height="18" Stretch="Fill" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Data="M 12,2 L 14.94,8.04 L 21.61,9.02 L 16.8,13.72 L 17.93,20.36 L 12,17.22 L 6.07,20.36 L 7.2,13.72 L 2.39,9.02 L 9.06,8.04 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedVoiceFavorite}" Value="True">
                                            <Setter Property="Fill" Value="#FFFFC857" />
                                            <Setter Property="Stroke" Value="#FFFFC857" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <!-- 试听按钮（带进度环） -->
                    <Grid Width="36" Height="36" Margin="0,0,4,0"
                          Visibility="{Binding CachedVoiceSampleUrl, Converter={StaticResource StringToVisibilityConverter}}">
                        <Ellipse x:Name="DisplayRestBorder" StrokeThickness="1"
                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" Fill="Transparent">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisplayVoicePreviewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse x:Name="DisplayTrack" StrokeThickness="1.5"
                                 Stroke="#1FFFFFFF" Fill="Transparent"
                                 Visibility="{Binding IsDisplayVoicePreviewing, Converter={StaticResource BtvConverter}}" />
                        <Ellipse StrokeThickness="1.5" Stroke="White" Fill="Transparent"
                                 StrokeDashArray="72.26 72.26"
                                 StrokeDashOffset="{Binding PreviewProgress, Converter={StaticResource ProgressToDashOffsetConverter}}"
                                 StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5"
                                 Visibility="{Binding IsDisplayVoicePreviewing, Converter={StaticResource BtvConverter}}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Grid Style="{StaticResource PreviewPreparingSpinner}" Tag="{Binding IsDisplayVoicePreparing}"
                              IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                            <Ellipse Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent"
                                     StrokeDashArray="18 54" StrokeDashCap="Round" />
                        </Grid>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Width="36" Height="36"
                                Command="{Binding ToggleDisplayPreviewCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_PlaySample}" />
                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_PlaySample}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisplayVoicePreviewing}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_Stop}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_Stop}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDisplayVoicePreparing}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_CancelLoading}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Preview_CancelLoading}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <view:InkCenteredGlyph FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <view:InkCenteredGlyph.Style>
                                        <Style TargetType="view:InkCenteredGlyph">
                                            <Setter Property="Glyph" Value="&#xE768;" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDisplayVoicePreviewActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </view:InkCenteredGlyph.Style>
                                </view:InkCenteredGlyph>
                                <Border Width="10" Height="10" CornerRadius="1" Background="White"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsDisplayVoicePreviewActive, Converter={StaticResource BtvConverter}}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Button
                        Style="{StaticResource BareIconButtonStyle}"
                        Command="{Binding ClearVoiceCommand}"
                        Content="&#xE711;"
                        ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearVoice}"
                        AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearVoice}"
                        Visibility="{Binding CachedVoiceId, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>
                <Ellipse DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center"
                         Visibility="{Binding CachedVoiceCoverUrl, Converter={StaticResource StringToVisibilityConverter}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding CachedVoiceCoverUrl}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource VoiceTitleButtonStyle}" Command="{Binding CopyVoiceIdCommand}"
                            CommandParameter="{Binding CachedVoiceId}">
                        <TextBlock FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding CachedVoiceTitle}" />
                                    <Setter Property="Visibility" Value="{Binding CachedVoiceTitle, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CachedVoiceId}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_RandomVoice}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Button>
                    <TextBlock Text="{Binding CachedVoiceDescription}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="36"
                               Visibility="{Binding CachedVoiceDescription, Converter={StaticResource StringToVisibilityConverter}}" />
                    <view:VoiceLanguageTags Languages="{Binding CachedVoiceLanguages}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CachedVoiceAuthor}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                   Visibility="{Binding CachedVoiceAuthor, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"
                                   Visibility="{Binding CachedVoiceId, Converter={StaticResource StringToVisibilityConverter}}">
                            <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Popularity}" />
                            <Run Text="{Binding CachedVoiceTaskCount, Converter={StaticResource TaskCountConverter}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 选项卡栏 -->
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SearchTabButton" BorderThickness="0" Padding="8,6" Margin="0,0,2,0"
                        Command="{Binding SwitchToSearchCommand}">
                    <Button.Resources>
                        <DrawingBrush x:Key="ButtonBackgroundPressed" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=SearchTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".16">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                        <DrawingBrush x:Key="ButtonBackgroundPointerOver" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=SearchTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".08">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Foreground, ElementName=SearchTabLabel}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="SearchTabLabel" Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Tab_Search}"
                                   VerticalAlignment="Center" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="ByIdTabButton" BorderThickness="0" Padding="8,6" Margin="0,0,2,0"
                        Command="{Binding SwitchToByIdCommand}">
                    <Button.Resources>
                        <DrawingBrush x:Key="ButtonBackgroundPressed" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=ByIdTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".16">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                        <DrawingBrush x:Key="ButtonBackgroundPointerOver" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=ByIdTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".08">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsByIdMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Foreground, ElementName=ByIdTabLabel}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="ByIdTabLabel" Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Tab_ById}"
                                   VerticalAlignment="Center" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsByIdMode}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="FavoritesTabButton" BorderThickness="0" Padding="8,6" Margin="0,0,2,0"
                        Command="{Binding SwitchToFavoritesCommand}">
                    <Button.Resources>
                        <DrawingBrush x:Key="ButtonBackgroundPressed" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=FavoritesTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".16">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                        <DrawingBrush x:Key="ButtonBackgroundPointerOver" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="{Binding Background, ElementName=FavoritesTabButton}" Geometry="M0,0 H1 V1 H0 Z" />
                                    <DrawingGroup Opacity=".08">
                                        <GeometryDrawing Brush="{DynamicResource TextFillColorPrimaryBrush}" Geometry="M0,0 H1 V1 H0 Z" />
                                    </DrawingGroup>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavoritesMode}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Foreground, ElementName=FavoritesTabLabel}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="FavoritesTabLabel" Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Tab_Favorites}" VerticalAlignment="Center" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavoritesMode}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid MinHeight="36">
            <!-- 搜索面板 -->
            <ikw:SimpleStackPanel Spacing="8"
                Visibility="{Binding IsSearchMode, Converter={StaticResource BtvConverter}}">
                <DockPanel x:Name="VoiceSearchInputRow" Height="36">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6"
                            Background="Transparent" BorderThickness="0"
                            Command="{Binding SearchVoicesCommand}"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Search_24_Regular}" FontSize="16" />
                    </Button>
                    <TextBox helpers:TextBoxHelper.IsDeleteButtonVisible="False"
                        ui:ControlHelper.PlaceholderText="{DynamicResource STranslate_Plugin_Tts_FishAudio_SearchPlaceholder}"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchVoicesCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <ikw:SimpleStackPanel Spacing="8" Visibility="{Binding HasSearched, Converter={StaticResource BtvConverter}}">
                    <DockPanel LastChildFill="True">
                        <ToggleButton x:Name="VoiceSearchResultsToggle" DockPanel.Dock="Right" IsChecked="True" IsThreeState="False">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource ResultToggleStyle}">
                                    <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_ExpandSearchResults}" />
                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_ExpandSearchResults}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_CollapseSearchResults}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_CollapseSearchResults}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <Path Style="{StaticResource ResultToggleChevronStyle}" />
                        </ToggleButton>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="Consolas">
                            <Run Text="{Binding SearchResultCountText, Mode=OneWay}" />
                            <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_ResultCount}" />
                        </TextBlock>
                    </DockPanel>
                    <ikw:SimpleStackPanel x:Name="VoiceSearchResultsBody" Spacing="8"
                                          Visibility="{Binding IsChecked, ElementName=VoiceSearchResultsToggle, Converter={StaticResource BtvConverter}}">
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding SearchHasUncertainExtent, Converter={StaticResource BtvConverter}}"
                           Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_SearchWindowHint}" />
                <ItemsControl ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource VoiceCardTemplate}" />
                <Grid Visibility="{Binding ShowPagination, Converter={StaticResource BtvConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Left" Command="{Binding PrevPageCommand}"
                            Style="{StaticResource BareIconButtonStyle}" Content="&#xE76B;"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Prev}"
                            AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Prev}"
                            Visibility="{Binding ShowPrevPage, Converter={StaticResource BtvConverter}}" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox helpers:TextBoxHelper.IsDeleteButtonVisible="False" x:Name="PageInputBox" Width="40" TextAlignment="Center" FontFamily="Consolas"
                                 FontSize="12" Padding="4,2" VerticalContentAlignment="Center"
                                 Text="{Binding PageInput, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="PageInputBox_PreviewTextInput"
                                 LostFocus="PageInputBox_LostFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitPageInputCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_PageOf}" />
                            <Run Text="{Binding SearchPageLimitText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" HorizontalAlignment="Right" Command="{Binding NextPageCommand}"
                            Style="{StaticResource BareIconButtonStyle}" Content="&#xE76C;"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Next}"
                            AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Next}"
                            Visibility="{Binding ShowNextPage, Converter={StaticResource BtvConverter}}" />
                </Grid>
                    </ikw:SimpleStackPanel>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>

            <!-- 通过 ID 面板 -->
            <ikw:SimpleStackPanel Spacing="8">
                <ikw:SimpleStackPanel.Style>
                    <Style TargetType="ikw:SimpleStackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsByIdMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ikw:SimpleStackPanel.Style>
                <Grid x:Name="VoiceIdInputRow" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox helpers:TextBoxHelper.IsDeleteButtonVisible="False" Padding="10,5,40,6" MaxLength="32"
                                 PreviewTextInput="VoiceIdInput_PreviewTextInput" DataObject.Pasting="VoiceIdInput_Pasting"
                                 ui:ControlHelper.PlaceholderText="{DynamicResource STranslate_Plugin_Tts_FishAudio_VoiceId_Placeholder}"
                                 Text="{Binding VoiceIdInput, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SubmitVoiceIdCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Margin="0,0,4,0" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding PasteVoiceIdCommand}"
                                ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Paste}"
                                AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Paste}">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="6"
                            Background="Transparent" BorderThickness="0"
                            Command="{Binding SubmitVoiceIdCommand}"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search}"
                            AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Search}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Search_24_Regular}" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding VoiceIdError}" TextWrapping="Wrap"
                           Visibility="{Binding VoiceIdError, Converter={StaticResource StringToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding ByIdResults}" ItemTemplate="{StaticResource VoiceCardTemplate}"
                              Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BtvConverter}}" />
            </ikw:SimpleStackPanel>
            <ikw:SimpleStackPanel Spacing="8" Visibility="{Binding IsFavoritesMode, Converter={StaticResource BtvConverter}}">
                <DockPanel LastChildFill="True">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FavoriteCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <ToggleButton x:Name="FavoriteVoicesToggle" DockPanel.Dock="Right" IsChecked="True" IsThreeState="False">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ResultToggleStyle}">
                                <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorites_Expand}" />
                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorites_Expand}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="ToolTip" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorites_Collapse}" />
                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorites_Collapse}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Path Style="{StaticResource ResultToggleChevronStyle}" />
                    </ToggleButton>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontFamily="Consolas">
                        <Run Text="{Binding FavoriteCount, Mode=OneWay}" />
                        <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_ResultCount}" />
                    </TextBlock>
                </DockPanel>
                    <TextBlock Text="{Binding FavoritesError}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding FavoritesError, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Favorites_Empty}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FavoriteCount}" Value="0" />
                                            <Condition Binding="{Binding FavoritesError}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                <ikw:SimpleStackPanel x:Name="FavoriteVoicesBody" Spacing="8"
                                      Visibility="{Binding IsChecked, ElementName=FavoriteVoicesToggle, Converter={StaticResource BtvConverter}}">
                    <ItemsControl ItemsSource="{Binding FavoriteResults}" ItemTemplate="{StaticResource VoiceCardTemplate}" />
                <Grid Visibility="{Binding ShowFavoritePagination, Converter={StaticResource BtvConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Left" Command="{Binding FavoritePrevPageCommand}"
                            Style="{StaticResource BareIconButtonStyle}" Content="&#xE76B;"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Prev}"
                            AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Prev}"
                            Visibility="{Binding ShowFavoritePrevPage, Converter={StaticResource BtvConverter}}" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBox helpers:TextBoxHelper.IsDeleteButtonVisible="False" x:Name="FavoritePageInputBox" Width="40" TextAlignment="Center" FontFamily="Consolas"
                                 FontSize="12" Padding="4,2" VerticalContentAlignment="Center"
                                 Text="{Binding FavoritePageInput, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="PageInputBox_PreviewTextInput"
                                 LostFocus="FavoritePageInputBox_LostFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitFavoritePageInputCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_PageOf}" />
                            <Run Text="{Binding FavoriteTotalPages, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" HorizontalAlignment="Right" Command="{Binding FavoriteNextPageCommand}"
                            Style="{StaticResource BareIconButtonStyle}" Content="&#xE76C;"
                            ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_Next}"
                            AutomationProperties.Name="{DynamicResource STranslate_Plugin_Tts_FishAudio_Next}"
                            Visibility="{Binding ShowFavoriteNextPage, Converter={StaticResource BtvConverter}}" />
                </Grid>
                </ikw:SimpleStackPanel>
            </ikw:SimpleStackPanel>
        </Grid>

        <!-- ════════ 模型 ════════ -->

        <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Model}" />

        <ui:SettingsCard x:Name="SynthesisModelCard" Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Engine}">
            <ui:SettingsCard.Description>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Engine_Description_Paid}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsS21ProFreeAvailable}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Engine_Description_Free}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.BrainCircuit_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox MinWidth="120" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" />
        </ui:SettingsCard>

        <!-- ════════ 音频输出 ════════ -->

        <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_AudioOutput}" />

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Format}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.MusicNote2_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:SettingsCard.Description>
                <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Format_Description}" />
            </ui:SettingsCard.Description>
            <ComboBox MinWidth="100" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioFormat}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="pcm">
                                            <Setter Property="Text" Value="PCM" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="mp3">
                                            <Setter Property="Text" Value="MP3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Mp3Bitrate}"
                         Visibility="{Binding IsMp3BitrateEnabled, Converter={StaticResource BtvConverter}}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.MusicNote2_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox MinWidth="100" ItemsSource="{Binding Mp3Bitrates}" SelectedItem="{Binding Mp3Bitrate}" />
        </ui:SettingsCard>

        <!-- ════════ 韵律 ════════ -->

        <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Prosody}" />

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Speed}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TopSpeed_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Width="270" Height="32" HorizontalAlignment="Left">
                <view:NumericSlider Width="180" IsSnapToTickEnabled="True" Maximum="2.0" Minimum="0.5" TickFrequency="0.01" SmallChange="0.01" AutoToolTipPrecision="2" AutoToolTipPlacement="TopLeft" Value="{Binding Speed}" />
                <view:InlineNumericEditor Margin="8,0,0,0" Value="{Binding Speed}" Minimum="0.5" Maximum="2" DecimalPlaces="2"
                                          Label="{DynamicResource STranslate_Plugin_Tts_FishAudio_Speed}" />
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Volume}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Speaker2_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Width="270" Height="32" HorizontalAlignment="Left">
                <view:NumericSlider Width="180" IsSnapToTickEnabled="True" Maximum="10" Minimum="-10" TickFrequency="0.01" SmallChange="0.01" AutoToolTipPrecision="2" AutoToolTipPlacement="TopLeft" Value="{Binding Volume}" />
                <view:InlineNumericEditor Margin="8,0,0,0" Value="{Binding Volume}" Minimum="-10" Maximum="10" DecimalPlaces="2" Unit="dB"
                                          Label="{DynamicResource STranslate_Plugin_Tts_FishAudio_Volume}" />
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard
            Visibility="{Binding IsNormalizeLoudnessEnabled, Converter={StaticResource BtvConverter}}"
            Description="{DynamicResource STranslate_Plugin_Tts_FishAudio_NormalizeLoudness_Description}"
            Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_NormalizeLoudness}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.MusicNote2_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding NormalizeLoudness}" />
        </ui:SettingsCard>

        <!-- ════════ 生成参数 ════════ -->

        <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Generation}" />

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Temperature}">
            <ui:SettingsCard.Description>
                <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Temperature_Description}" />
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Sparkle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Width="270" Height="32" HorizontalAlignment="Left">
                <view:NumericSlider Width="180" IsSnapToTickEnabled="True" Maximum="1.0" Minimum="0" TickFrequency="0.01" SmallChange="0.01" AutoToolTipPrecision="2" AutoToolTipPlacement="TopLeft" Value="{Binding Temperature}" />
                <view:InlineNumericEditor Margin="8,0,0,0" Value="{Binding Temperature}" Minimum="0" Maximum="1" DecimalPlaces="2"
                                          Label="{DynamicResource STranslate_Plugin_Tts_FishAudio_Temperature}" />
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_TopP}">
            <ui:SettingsCard.Description>
                <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_TopP_Description}" />
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Diversity_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Width="270" Height="32" HorizontalAlignment="Left">
                <view:NumericSlider Width="180" IsSnapToTickEnabled="True" Maximum="1.0" Minimum="0.05" TickFrequency="0.01" SmallChange="0.01" AutoToolTipPrecision="2" AutoToolTipPlacement="TopLeft" Value="{Binding TopP}" />
                <view:InlineNumericEditor Margin="8,0,0,0" Value="{Binding TopP}" Minimum="0.05" Maximum="1" DecimalPlaces="2"
                                          Label="{DynamicResource STranslate_Plugin_Tts_FishAudio_TopP}" />
            </StackPanel>
        </ui:SettingsCard>

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Latency}">
            <ui:SettingsCard.Description>
                <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Latency_Description}" />
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Timer_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox MinWidth="120" ItemsSource="{Binding Latencies}" SelectedItem="{Binding SelectedLatency}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="normal">
                                            <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Latency_Normal}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="balanced">
                                            <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Latency_Balanced}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="low">
                                            <Setter Property="Text" Value="{DynamicResource STranslate_Plugin_Tts_FishAudio_Latency_Low}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ui:SettingsCard>

        <ui:SettingsCard
            Description="{DynamicResource STranslate_Plugin_Tts_FishAudio_Normalize_Description}"
            Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Normalize}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextEditStyle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding Normalize}" />
        </ui:SettingsCard>

        <ui:SettingsCard
            Description="{DynamicResource STranslate_Plugin_Tts_FishAudio_ConditionOnPreviousChunks_Description}"
            Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_ConditionOnPreviousChunks}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.LinkMultiple_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ui:ToggleSwitch IsOn="{Binding ConditionOnPreviousChunks}" />
        </ui:SettingsCard>

        <!-- ════════ 其他 ════════ -->

        <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_Group_Misc}" />

        <ui:SettingsCard Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Cache}">
            <ui:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_CacheUsage}" />
                    <TextBlock Margin="4,0,0,0" Text="{Binding CoverImageCacheSizeText}" />
                </StackPanel>
            </ui:SettingsCard.Description>
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Image_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <Button Padding="10,4"
                    Command="{Binding ClearCoverImageCacheCommand}"
                    ToolTip="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearCache}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,6,0"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="{Binding IsClearingCoverImageCache, Converter={StaticResource BtvConverter}}">
                        <Grid.RenderTransform>
                            <RotateTransform />
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClearingCoverImageCache}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="ClearCacheBusyStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.9"
                                                        RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="ClearCacheBusyStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Fill="Transparent"
                                 Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                 StrokeDashArray="2 2"
                                 StrokeDashCap="Round"
                                 StrokeThickness="2" />
                    </Grid>
                    <TextBlock Text="{DynamicResource STranslate_Plugin_Tts_FishAudio_ClearCache}" />
                </StackPanel>
            </Button>
        </ui:SettingsCard>

        <ui:SettingsCard
            x:Name="SupportCard"
            Description="{DynamicResource STranslate_Plugin_Tts_FishAudio_Support_Description}"
            Header="{DynamicResource STranslate_Plugin_Tts_FishAudio_Support}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PersonSupport_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBlock x:Name="ProjectRepositoryText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <InlineUIContainer BaselineAlignment="Center">
                    <!-- GitHub Octicons mark-github-16; MIT notice: Assets/Licenses/Octicons.LICENSE.txt. -->
                    <Path x:Name="ProjectRepositoryIcon" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TextBlock}}"
                          Data="F1 M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
                </InlineUIContainer><Hyperlink x:Name="ProjectRepositoryLink" NavigateUri="https://github.com/Cirnouo/STranslate.Plugin.Tts.FishAudio"
                           RequestNavigate="ProjectRepositoryLink_RequestNavigate">GitHub</Hyperlink>
            </TextBlock>
        </ui:SettingsCard>

    </ikw:SimpleStackPanel>
</UserControl>
