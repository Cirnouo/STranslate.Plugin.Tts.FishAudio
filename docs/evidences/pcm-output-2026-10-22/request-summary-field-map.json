{
  "source": "original request-summary.json",
  "destination": "capture/request-summary.sanitized.json",
  "rules": [
    "Only the listed source fields are copied; no recursive catch-all copy is performed.",
    "Retained values and JSON types are unchanged. Authorization is already [REDACTED].",
    "Assembly identities contain name/version/bytes/SHA-256 only; no local assembly paths.",
    "The original file is represented by its exact SHA-256 and byte count, not included.",
    "All fields not explicitly retained are omitted, including local source context and implementation notes.",
    "The original capture summary is retained verbatim and still lists original hashes for omitted artifacts."
  ],
  "retainedFields": [
